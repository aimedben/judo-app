<?xml version="1.0" encoding="utf-8"?><!--
   Sauvegarde complète (Android 11 et antérieurs).
   Toutes les données de gestion du club sont conservées : base Room (athlètes,
   catégories, coachs, planning, séances passées), préférences (paramètres du club,
   clés Supabase) et fichiers internes (instantané `jcsdb`). Les caches sont exclus.
-->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="sharedpref" path="." />
    <include domain="file" path="." />
    <exclude domain="file" path="cache" />
</full-backup-content>
