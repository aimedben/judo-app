<?xml version="1.0" encoding="utf-8"?><!--
   Règles de sauvegarde / transfert (Android 12+).
   On conserve les données du club (base Room, préférences, instantané `jcsdb`)
   et on exclut uniquement les caches régénérables.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
        <exclude domain="file" path="cache" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
